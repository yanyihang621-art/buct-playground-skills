{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Bibliographic Record Library",
  "type": "object",
  "required": ["schema_version", "record_count", "records"],
  "properties": {
    "schema_version": {"type": "string"},
    "record_count": {"type": "integer", "minimum": 0},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref_id", "cite_key", "entry_type", "title", "authors", "source_provenance"],
        "properties": {
          "ref_id": {"type": "string"},
          "cite_key": {"type": "string"},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "entry_type": {"type": "string"},
          "title": {"type": "string"},
          "authors": {"type": "array", "items": {"type": "string"}},
          "year": {"type": ["integer", "null"]},
          "venue": {"type": ["string", "null"]},
          "volume": {"type": ["string", "null"]},
          "issue": {"type": ["string", "null"]},
          "pages": {"type": ["string", "null"]},
          "doi": {"type": ["string", "null"]},
          "arxiv_id": {"type": ["string", "null"]},
          "url": {"type": ["string", "null"]},
          "keywords": {"type": "array", "items": {"type": "string"}},
          "abstract": {"type": ["string", "null"]},
          "language": {"type": "string"},
          "missing_fields": {"type": "array", "items": {"type": "string"}},
          "source_provenance": {"type": "array", "items": {"type": "object"}}
        }
      }
    }
  }
}
