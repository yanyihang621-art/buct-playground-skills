{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bilingual Literature Translation Output",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "source_file",
    "source_lang",
    "target_lang",
    "glossary",
    "segments",
    "uncertainties",
    "qa_report"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "status": {"type": "string", "enum": ["completed", "partial", "refused"]},
    "source_file": {"type": "string"},
    "source_lang": {"type": "string"},
    "target_lang": {"type": "string"},
    "title_en": {"type": ["string", "null"]},
    "title_zh": {"type": ["string", "null"]},
    "glossary": {"type": "object"},
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "segment_id",
          "block_id",
          "page",
          "role",
          "source_text",
          "target_text",
          "protected_tokens",
          "locked_terms_used",
          "status"
        ],
        "properties": {
          "segment_id": {"type": "string"},
          "block_id": {"type": "string"},
          "page": {"type": "integer", "minimum": 1},
          "role": {"type": "string"},
          "section_path": {"type": "array", "items": {"type": "string"}},
          "source_text": {"type": "string"},
          "masked_text": {"type": "string"},
          "target_text": {"type": "string"},
          "sentence_alignment": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["sentence_id", "source_start", "source_end", "source_text", "target_text"],
              "properties": {
                "sentence_id": {"type": "string"},
                "source_start": {"type": "integer", "minimum": 0},
                "source_end": {"type": "integer", "minimum": 1},
                "source_text": {"type": "string"},
                "target_text": {"type": "string"}
              }
            }
          },
          "rationale": {"type": "string"},
          "protected_tokens": {"type": "object"},
          "locked_terms_used": {"type": "array", "items": {"type": "string"}},
          "status": {"type": "string", "enum": ["translated", "verbatim", "uncertain", "untranslatable"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "tables_bilingual": {"type": "array"},
    "uncertainties": {"type": "array"},
    "qa_report": {"type": "object"}
  }
}
