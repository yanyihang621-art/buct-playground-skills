{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Writing 09 Methods & Experiments Result",
  "type": "object",
  "required": [
    "schema_version",
    "challenge_id",
    "case_id",
    "status",
    "language",
    "summary",
    "metrics",
    "artifacts",
    "sources",
    "claim_sources",
    "change_records",
    "uncertainties",
    "author_questions",
    "verification"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "challenge_id": {"type": "string"},
    "case_id": {"description": "Original case identifier; null when absent, with a diagnostic."},
    "status": {"type": "string", "enum": ["completed", "partial", "refused"]},
    "language": {"type": "string"},
    "summary": {"type": "string"},
    "metrics": {"type": "object"},
    "artifacts": {"type": "object", "additionalProperties": {"type": "string"}, "description": "Existing files relative to the output directory."},
    "sources": {"type": "array"},
    "claim_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "source", "locator", "quote"],
        "properties": {
          "claim": {"type": "string"},
          "source": {"type": "string"},
          "locator": {"type": "string"},
          "quote": {"type": "string"}
        }
      }
    },
    "change_records": {"type": "array"},
    "uncertainties": {"type": "array"},
    "author_questions": {"type": "array"},
    "verification": {"type": "object"}
  }
}
