{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reading 10 & 14 Agent Answer Input",
  "type": "object",
  "required": ["fields", "status"],
  "properties": {
    "fields": {"type": "object"},
    "status": {"type": "string", "enum": ["success", "partial", "unable"]},
    "status_reason": {"type": "string"},
    "evidence": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["anchor", "quote"],
          "properties": {
            "anchor": {"type": "string"},
            "quote": {"type": "string"}
          }
        }
      }
    },
    "uncertainties": {"type": "array"},
    "derived_values": {"type": "array"}
  }
}
