{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StructuredLiteratureNotes",
  "description": "Schema for section-aligned, provenance-anchored structured literature notes, Paper Cards, searchable knowledge entries, and verification ledgers.",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "paper_count",
    "papers",
    "comparison_matrix",
    "search_index",
    "verification_ledger",
    "uncertainties"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["success", "partial", "unverifiable", "refused"]
    },
    "paper_count": { "type": "integer", "minimum": 0 },
    "papers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "paper_id",
          "source_file",
          "status",
          "paper_card",
          "section_notes",
          "knowledge_entries",
          "terminology_glossary",
          "conflicts",
          "search_index",
          "verification_ledger",
          "uncertainties"
        ],
        "properties": {
          "paper_id": { "type": "string" },
          "source_file": { "type": "string" },
          "status": { "type": "string", "enum": ["success", "partial", "unverifiable", "refused"] },
          "paper_card": { "type": "object" },
          "section_notes": { "type": "array", "items": { "type": "object" } },
          "knowledge_entries": { "type": "array", "items": { "type": "object" } },
          "terminology_glossary": { "type": "array", "items": { "type": "object" } },
          "conflicts": { "type": "array", "items": { "type": "object" } },
          "search_index": { "type": "object" },
          "verification_ledger": { "type": "object" },
          "uncertainties": { "type": "array", "items": { "type": "object" } }
        }
      }
    },
    "comparison_matrix": { "type": "array", "items": { "type": "object" } },
    "search_index": { "type": "object" },
    "verification_ledger": { "type": "object" },
    "uncertainties": { "type": "array", "items": { "type": "object" } }
  }
}
