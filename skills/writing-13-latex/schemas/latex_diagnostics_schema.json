{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LaTeX Log & Static Diagnostics",
  "type": "object",
  "required": ["schema_version", "error_count", "warning_count", "root_causes", "diagnostics"],
  "properties": {
    "schema_version": {"type": "string"},
    "error_count": {"type": "integer", "minimum": 0},
    "warning_count": {"type": "integer", "minimum": 0},
    "has_undefined_refs": {"type": "boolean"},
    "has_undefined_cites": {"type": "boolean"},
    "overfull_hbox_count": {"type": "integer", "minimum": 0},
    "root_causes": {"type": "array", "items": {"type": "object"}},
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "severity", "message"],
        "properties": {
          "category": {"type": "string"},
          "severity": {"type": "string", "enum": ["fatal", "error", "warning"]},
          "file": {"type": ["string", "null"]},
          "line": {"type": ["integer", "null"]},
          "message": {"type": "string"},
          "is_cascade": {"type": "boolean"},
          "hint": {"type": "string"}
        }
      }
    }
  }
}
