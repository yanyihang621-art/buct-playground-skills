{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NanopublicationCollection",
  "description": "4-graph Nanopublication bundle with controlled relations, grounded provenance, deduplication, and quality audit metrics.",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "source_metadata",
    "nanopub_count",
    "nanopublications",
    "deduplication_log",
    "conflicts",
    "uncertainties"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "status": { "type": "string", "enum": ["success", "partial", "unverifiable", "refused"] },
    "source_metadata": { "type": "object" },
    "nanopub_count": { "type": "integer", "minimum": 0 },
    "nanopublications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nanopub_id", "nanopub_uri", "head", "assertion", "provenance", "pubinfo"],
        "properties": {
          "nanopub_id": { "type": "string" },
          "nanopub_uri": { "type": "string" },
          "head": { "type": "object" },
          "assertion": {
            "type": "object",
            "required": ["subject", "predicate", "predicate_uri", "object", "conditions", "atomic_statement"],
            "properties": {
              "subject": { "type": "string" },
              "predicate": { "type": "string" },
              "predicate_uri": { "type": "string" },
              "object": { "type": "string" },
              "modality": { "enum": ["asserted", "hedged"] },
              "polarity": { "enum": ["affirmative", "negative"] },
              "conditions": { "type": "array", "items": { "type": "string" } },
              "atomic_statement": { "type": "string" }
            }
          },
          "provenance": {
            "type": "object",
            "required": ["evidence_type", "minimal_evidence_snippet", "location", "source_metadata"],
            "properties": {
              "evidence_type": {
                "type": "string",
                "enum": ["direct_experimental", "direct_tabular_or_figure", "direct_textual", "indirect_inference", "cited_prior_work"]
              },
              "minimal_evidence_snippet": { "type": "string" },
              "location": { "type": "object" },
              "source_metadata": { "type": "object" }
            }
          },
          "pubinfo": {
            "type": "object",
            "required": ["created_at", "creator", "confidence_score", "confidence_basis"]
          }
        }
      }
    },
    "deduplication_log": { "type": "array", "items": { "type": "object" } },
    "conflicts": { "type": "array", "items": { "type": "object" } },
    "uncertainties": { "type": "array", "items": { "type": "object" } }
  }
}
