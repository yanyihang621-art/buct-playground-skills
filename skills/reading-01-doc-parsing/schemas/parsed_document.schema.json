{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ParsedScientificDocument",
  "description": "Structured scientific PDF parsing output with page/bbox provenance, reading order, tables, formulas, figures, references, and explicit anomaly/uncertainty reporting.",
  "type": "object",
  "required": [
    "schema_version",
    "source_file",
    "status",
    "diagnostics",
    "metadata",
    "sections",
    "blocks",
    "headers_footers",
    "marginalia",
    "footnotes",
    "tables",
    "figures",
    "formulas",
    "references",
    "uncertainties",
    "change_log"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "source_file": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["success", "partial", "unverifiable", "refused"]
    },
    "diagnostics": {
      "type": "object",
      "required": [
        "encrypted",
        "page_count",
        "body_font_size",
        "page_profiles",
        "page_number_map",
        "anomalies",
        "environment_capabilities"
      ],
      "properties": {
        "encrypted": { "type": "boolean" },
        "page_count": { "type": "integer", "minimum": 0 },
        "body_font_size": { "type": "number" },
        "page_profiles": { "type": "array", "items": { "type": "object" } },
        "page_number_map": { "type": "array", "items": { "type": "object" } },
        "anomalies": { "type": "array", "items": { "type": "object" } },
        "environment_capabilities": { "type": "object" }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "title": { "type": ["string", "null"] },
        "authors": { "type": "array", "items": { "type": "string" } },
        "affiliations": { "type": "array", "items": { "type": "string" } },
        "abstract": { "type": ["string", "null"] },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "toc": { "type": "array", "items": { "type": "object" } }
      }
    },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/sectionNode" }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "block_id",
          "role",
          "page",
          "bbox",
          "column",
          "reading_order",
          "raw_text",
          "text",
          "structured_text",
          "confidence",
          "extraction_method"
        ],
        "properties": {
          "block_id": { "type": "string" },
          "role": { "type": "string" },
          "page": { "type": "integer", "minimum": 1 },
          "printed_page": { "type": ["string", "null"] },
          "bbox": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 4,
            "maxItems": 4
          },
          "column": { "type": ["integer", "string", "null"] },
          "reading_order": { "type": "integer", "minimum": 1 },
          "section_id": { "type": ["string", "null"] },
          "section_path": { "type": "array", "items": { "type": "string" } },
          "raw_text": { "type": "string" },
          "text": { "type": "string" },
          "structured_text": { "type": "string" },
          "continuation_of": { "type": ["string", "null"] },
          "continued_by": { "type": ["string", "null"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "extraction_method": { "type": "string" }
        }
      }
    },
    "headers_footers": { "type": "array", "items": { "type": "object" } },
    "marginalia": { "type": "array", "items": { "type": "object" } },
    "footnotes": { "type": "array", "items": { "type": "object" } },
    "tables": { "type": "array", "items": { "type": "object" } },
    "figures": { "type": "array", "items": { "type": "object" } },
    "formulas": {
      "type": "object",
      "properties": {
        "display_equations": { "type": "array", "items": { "type": "object" } },
        "inline_formula_spans": { "type": "array", "items": { "type": "object" } },
        "stats": { "type": "object" }
      }
    },
    "references": { "type": "array", "items": { "type": "object" } },
    "uncertainties": { "type": "array", "items": { "type": "object" } },
    "change_log": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "sectionNode": {
      "type": "object",
      "required": [
        "section_id",
        "level",
        "title",
        "page_start",
        "page_end",
        "bbox",
        "block_ids",
        "children"
      ],
      "properties": {
        "section_id": { "type": "string" },
        "level": { "type": "integer", "minimum": 1 },
        "number": { "type": ["string", "null"] },
        "title": { "type": "string" },
        "page_start": { "type": "integer", "minimum": 1 },
        "page_end": { "type": "integer", "minimum": 1 },
        "bbox": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4
        },
        "block_ids": { "type": "array", "items": { "type": "string" } },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/sectionNode" }
        }
      }
    }
  }
}
